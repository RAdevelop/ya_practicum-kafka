BOOTSTRAP_SERVERS=kafka-b-1:9093,kafka-b-2:9093,kafka-b-3:9093

PRODUCER_DEBUG=""
PRODUCER_ACKS="all"
PRODUCER_RETRIES=10
PRODUCER_RETRY_BACKOFF_MS=100
PRODUCER_ENABLE_IDEMPOTENCE=true
PRODUCER_MAX_IN_FLIGHT_REQUESTS_PER_CONNECTION=5
PRODUCER_FLUSH_TIMEOUT_MS=15000
PRODUCER_SOCKET_CONNECTION_SETUP_TIMEOUT_MS=10000
PRODUCER_SOCKET_TIMEOUT_MS=30000

PRODUCER_SECURITY_PROTOCOL="SSL"
PRODUCER_SSL_CA_LOCATION="creds/producer/truststore.pem"
PRODUCER_SSL_CERTIFICATE_LOCATION="creds/producer/keystore.pem"
PRODUCER_SSL_KEY_LOCATION="creds/producer/keystore.key"
PRODUCER_SSL_KEY_PASSWORD="kafka123"

CONSUMER_DEBUG=""
CONSUMER_GROUP_ID="consumer_group_id"
CONSUMER_AUTO_OFFSET_RESET="earliest"
CONSUMER_ENABLE_AUTO_COMMIT=false
CONSUMER_ENABLE_AUTO_OFFSET_STORE=false
CONSUMER_FETCH_MIN_BYTES=1
CONSUMER_FETCH_WAIT_MAX_MS=100

CONSUMER_SECURITY_PROTOCOL="SSL"
CONSUMER_SSL_CA_LOCATION="creds/consumer/truststore.pem"
CONSUMER_SSL_CERTIFICATE_LOCATION="creds/consumer/keystore.pem"
CONSUMER_SSL_KEY_LOCATION="creds/consumer/keystore.key"
CONSUMER_SSL_KEY_PASSWORD="kafka123"

TOPIC_SHOP_PRODUCTS="shop_products"

# https://schema-registry:8081 - для взаимодействия внутри сети контейнеров
# для внешнего подключения, указать https://localhost:8081, а лучше явный адрес
SCHEMA_REGISTRY_URL="https://schema-registry:8081"
SCHEMA_REGISTRY_SSL_CERTIFICATE_LOCATION="creds/schema-registry/keystore.pem"
SCHEMA_REGISTRY_SSL_KEY_LOCATION="creds/schema-registry/keystore.key"
SCHEMA_REGISTRY_SSL_CA_LOCATION="creds/schema-registry/truststore.pem"
SCHEMA_REGISTRY_SSL_DISABLE_ENDPOINT_VERIFICATION=false